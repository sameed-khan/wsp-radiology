# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Publicly downloadable/reproducible assets must not enter the DVC cache.
/data/
/models/
/features/
/.venv/
# Never ingest raw runtime state or conversations wholesale.
/.runtime/
/.pi/subagents/
