/.pi/subagents/
/.runtime/
/.env
/artifact-staging/
/artifacts/**
!/artifacts/.gitkeep
# DVC pointer files are versioned.
!/artifacts/*.dvc
!/artifacts/.gitignore
# agent folder contains temporary handoffs and other housekeeping
agent/
